# Tessera entry monitoring — systemd unit for Debian
#
# Install:
#   1. Node.js >= 24 (needed for the built-in node:sqlite), e.g. via NodeSource:
#        curl -fsSL https://deb.nodesource.com/setup_24.x | sudo bash -
#        sudo apt-get install -y nodejs
#      plus Bun, which installs the dependencies from bun.lock (the app itself
#      still runs on Node.js):
#        sudo npm install -g bun
#   2. Deploy the app:
#        sudo mkdir -p /opt/tessera
#        sudo rsync -a --exclude node_modules --exclude data ./ /opt/tessera/
#        cd /opt/tessera && sudo bun install --frozen-lockfile --production
#   3. Optional secrets (initial owner password):
#        echo 'OWNER_PASSWORD=change-me' | sudo tee /etc/tessera/env
#        sudo chmod 600 /etc/tessera/env
#   4. Enable:
#        sudo cp deploy/tessera.service /etc/systemd/system/
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now tessera
#
# The SQLite database lands in /var/lib/tessera (created automatically via
# StateDirectory). Put a TLS reverse proxy (nginx/Caddy) in front — the
# scanner needs HTTPS for camera access.
#
# Upgrading from a previous "voreinlass" install? The state dir and DB file
# were renamed. Carry the data over once (users will need to log in again):
#   sudo systemctl disable --now voreinlass
#   sudo mv /var/lib/voreinlass /var/lib/tessera
#   cd /var/lib/tessera && sudo rename 's/^voreinlass\.db/tessera.db/' voreinlass.db*
#   sudo rm -f /etc/systemd/system/voreinlass.service

[Unit]
Description=Tessera entry monitoring
After=network.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tessera
# apply pending schema migrations before starting (idempotent; the app would
# also self-migrate, but this fails fast and logs migrations separately)
ExecStartPre=/usr/bin/node server/migrate.js
ExecStart=/usr/bin/node server/index.js
Environment=NODE_ENV=production
Environment=PORT=3000
# listen on loopback only: the TLS reverse proxy on this machine is the public entry point.
# Remove HOST (or set 0.0.0.0) if the proxy runs on another machine.
Environment=HOST=127.0.0.1
# trust the proxy's X-Forwarded-For header so login throttling sees real client addresses
Environment=TRUST_PROXY=loopback
Environment=DATA_DIR=/var/lib/tessera
EnvironmentFile=-/etc/tessera/env

Restart=always
RestartSec=3

# runs as an ephemeral unprivileged user; /var/lib/tessera is its only
# writable state
DynamicUser=yes
StateDirectory=tessera
StateDirectoryMode=0700
UMask=0077

# hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
