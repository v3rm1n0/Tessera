# Runs tessera-backup.service every night; see that file for installation.
[Unit]
Description=Nightly Tessera database backup

[Timer]
OnCalendar=*-*-* 03:30:00
# spread the start a little, and catch up after a night the machine was off
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
